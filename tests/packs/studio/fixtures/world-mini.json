    ],
    "regions": [ { "id": "the-fen", "name": "The Fen" }, { "id": "high-moor", "name": "High Moor" } ],
    "realms": [ { "id": "lamplands", "name": "The Lamplands", "regions": ["the-fen"] } ],
    "placeKinds": { "lock town": "town", "marsh": "none" },
