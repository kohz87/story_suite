      { "from": "reedmoor", "to": "cairn", "kind": "trail", "km": 20 }
    ],
    "cast": [
      { "kind": "companion", "id": "wren", "name": "Wren Ashby", "role": "lamplighter", "gender": "Female", "age": 24, "look": "Soot on her cuffs.", "start": { "place": "fenhold", "goal": "Keep the lamps lit", "routine": "Rounds at dusk" }, "meters": { "trust": 10 }, "secrets": [ { "id": "bell", "text": "She has heard the bell.", "gate": "meter trust >= 40 of wren" } ], "ties": [ { "with": "old-tam", "tag": "mentor" } ], "portrait": "wren.webp" },
      { "kind": "figure", "id": "old-tam", "name": "Old Tam", "role": "ferryman", "protected": true }
    ],
    "conditions": [
