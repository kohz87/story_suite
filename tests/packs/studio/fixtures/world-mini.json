      { "name": "fen-flooded", "scope": "place", "fades": "until cleared", "means": "Water stands in the streets.", "placeStatus": true }
    ],
    "start": { "world": { "set": ["lamps-out@the-fen: 10 days"] } },
    "worldEvents": [ { "id": "high-water", "kind": "one-off", "severity": "minor", "requires": ["set:lamps-out@the-fen"], "effects": { "set": ["fen-flooded@reedmoor"] }, "cue": "The fen rises." } ],
